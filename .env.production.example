# KAMELA production environment template
# Copy to .env only on the target server. NEVER commit the real .env.

CI_ENVIRONMENT = production

app.baseURL = 'https://example.com/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

# Cookie must be Secure in HTTPS production.
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

# Session hardening from Phase 1.
session.cookieName = 'kamela_session'
session.expiration = 28800
session.timeToUpdate = 300
session.regenerateDestroy = true

# Database - fill with production credentials locally on the server.
database.default.hostname = localhost
database.default.database = pos_ci4
database.default.username = CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
